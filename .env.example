# Interline Asia - Secure Environment Configuration
# Copy this file to .env.local and replace with your actual values
# NEVER commit .env.local to version control

# Supabase Configuration (Public - safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Server-side Keys (KEEP SECRET - server only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=https://www.interlineasia.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@interlineasia.com
NEXT_PUBLIC_VERIFICATION_PASSCODE=your_verification_passcode_here

# Security Configuration
NEXTAUTH_SECRET=your_secure_random_string_minimum_32_characters
NEXTAUTH_URL=https://www.interlineasia.com

# Rate Limiting & Security
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
CSRF_SECRET=your_csrf_secret_here

# CSV Import Settings
ALLOW_QUOTE_ONLY=true
MAX_CSV_SIZE=10485760

# Monitoring & Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id
SENTRY_DSN=your_sentry_dsn_here

# Development Settings
NODE_ENV=production
LOG_LEVEL=info

# External API Keys (KEEP SECRET)
GITHUB_TOKEN=your_github_token_here
BREVO_API_KEY=your_brevo_api_key_here
