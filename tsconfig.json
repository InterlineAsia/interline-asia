{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"]
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "scripts/**/*",
    "api/**/*",
    "public/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}